<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7f6;
      font-family: &quot;Segoe UI&quot;, Tahoma, Geneva, Verdana, sans-serif;
      -webkit-font-smoothing: antialiased;
    "
  >
    <!-- Outer Wrapper -->
    <table
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #f4f7f6; padding: 40px 0"
    >
      <tr>
        <td align="center">
          <!-- Main Card Container -->
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              max-width: 500px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            "
          >
            <!-- Header Banner -->
            <tr>
              <td
                align="center"
                style="background-color: #4f46e5; padding: 30px 20px"
              >
                <h1
                  style="
                    color: #ffffff;
                    margin: 0;
                    font-size: 24px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                  "
                >
                  Verify Your Email Address
                </h1>
              </td>
            </tr>

            <!-- Content Area -->
            <tr>
              <td style="padding: 40px 30px; text-align: center">
                <p
                  style="
                    color: #333333;
                    font-size: 16px;
                    margin-top: 0;
                    margin-bottom: 20px;
                    line-height: 1.5;
                  "
                >
                  Hello <%= name %>,
                </p>
                <p
                  style="
                    color: #666666;
                    font-size: 15px;
                    margin-bottom: 30px;
                    line-height: 1.6;
                  "
                >
                  Thank you for signing up! Please use the OTP code below to
                  verify your email address and complete your account creation:
                </p>

                <!-- OTP Display Box -->
                <div
                  style="
                    background-color: #f0f3ff;
                    border: 2px dashed #4f46e5;
                    border-radius: 8px;
                    padding: 18px;
                    margin: 25px 0;
                    display: inline-block;
                    width: 80%;
                  "
                >
                  <span
                    style="
                      font-size: 32px;
                      font-weight: 700;
                      color: #4f46e5;
                      letter-spacing: 6px;
                      font-family: &quot;Courier New&quot;, Courier, monospace;
                    "
                  >
                    <%= otp %>
                  </span>
                </div>

                <!-- Dynamic Expiration Time -->
                <p
                  style="
                    color: #888888;
                    font-size: 13px;
                    margin-top: 25px;
                    margin-bottom: 0;
                  "
                >
                  This code will expire in
                  <strong
                    ><%= expiratinoSecend %> <%= expiratinoSecend > 1 ?
                    'minutes' : 'minute' %></strong
                  >.
                </p>
                <p
                  style="
                    color: #888888;
                    font-size: 13px;
                    margin-top: 8px;
                    margin-bottom: 0;
                  "
                >
                  If you did not create an account, please ignore this email.
                </p>
              </td>
            </tr>

            <!-- Divider Line -->
            <tr>
              <td style="padding: 0 30px">
                <hr
                  style="border: none; border-top: 1px solid #eeeeee; margin: 0"
                />
              </td>
            </tr>

            <!-- Footer Area -->
            <tr>
              <td
                align="center"
                style="padding: 25px 30px; background-color: #fafafa"
              >
                <p
                  style="
                    color: #aaaaaa;
                    font-size: 12px;
                    margin: 0;
                    line-height: 1.4;
                  "
                >
                  &copy; <%= new Date().getFullYear() %> Your Company Name. All
                  rights reserved.
                </p>
                <p
                  style="
                    color: #aaaaaa;
                    font-size: 12px;
                    margin-top: 5px;
                    margin-bottom: 0;
                  "
                >
                  Need help? Contact us at
                  <a
                    href="mailto:<%= email %>"
                    style="color: #4f46e5; text-decoration: none"
                  >
                    <%= email %>
                  </a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
