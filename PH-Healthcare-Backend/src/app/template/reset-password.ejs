<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Changed Successfully</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7f6;
      font-family: &quot;Segoe UI&quot;, Tahoma, Geneva, Verdana, sans-serif;
      -webkit-font-smoothing: antialiased;
    "
  >
    <!-- Outer Wrapper -->
    <table
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #f4f7f6; padding: 40px 0"
    >
      <tr>
        <td align="center">
          <!-- Main Card Container -->
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              max-width: 500px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            "
          >
            <!-- Success Header Banner -->
            <tr>
              <td
                align="center"
                style="background-color: #10b981; padding: 35px 20px"
              >
                <!-- Success Checkmark Icon (SVG) -->
                <table border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td
                      align="center"
                      style="
                        background-color: #ffffff;
                        border-radius: 50%;
                        width: 60px;
                        height: 60px;
                        line-height: 60px;
                      "
                    >
                      <span
                        style="
                          font-size: 30px;
                          color: #10b981;
                          font-weight: bold;
                          vertical-align: middle;
                        "
                        >✓</span
                      >
                    </td>
                  </tr>
                </table>
                <h1
                  style="
                    color: #ffffff;
                    margin-top: 15px;
                    margin-bottom: 0;
                    font-size: 22px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                  "
                >
                  Password Changed!
                </h1>
                <h1><%= name %></h1>
              </td>
            </tr>

            <!-- Content Area -->
            <tr>
              <td style="padding: 40px 30px; text-align: center">
                <p
                  style="
                    color: #333333;
                    font-size: 16px;
                    margin-top: 0;
                    margin-bottom: 15px;
                    line-height: 1.5;
                  "
                >
                  Hello,
                </p>
                <p
                  style="
                    color: #555555;
                    font-size: 15px;
                    margin-bottom: 25px;
                    line-height: 1.6;
                  "
                >
                  Your password has been successfully reset. You can now use
                  your new password to log in to your account.
                </p>

                <!-- Action Button -->
                <div style="margin: 30px 0">
                  <a
                    target="_blank"
                    style="
                      background-color: #10b981;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 14px 28px;
                      border-radius: 6px;
                      font-size: 15px;
                      font-weight: 600;
                      display: inline-block;
                    "
                  >
                    Log In to Your Account
                  </a>
                </div>

                <!-- Security Warning Box -->
                <div
                  style="
                    background-color: #fffbe6;
                    border-left: 4px solid #f59e0b;
                    padding: 15px;
                    text-align: left;
                    border-radius: 4px;
                    margin-top: 30px;
                  "
                >
                  <p
                    style="
                      color: #b45309;
                      font-size: 13px;
                      margin: 0;
                      line-height: 1.5;
                    "
                  >
                    <strong>Security Alert:</strong> If you did not perform this
                    action, your account may be compromised. Please contact our
                    support team immediately or reset your password again.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Divider Line -->
            <tr>
              <td style="padding: 0 30px">
                <hr
                  style="border: none; border-top: 1px solid #eeeeee; margin: 0"
                />
              </td>
            </tr>

            <!-- Footer Area -->
            <tr>
              <td
                align="center"
                style="padding: 25px 30px; background-color: #fafafa"
              >
                <p
                  style="
                    color: #aaaaaa;
                    font-size: 12px;
                    margin: 0;
                    line-height: 1.4;
                  "
                >
                  &copy; <%= new Date().getFullYear() %> Your Company Name. All
                  rights reserved.
                </p>
                <p
                  style="
                    color: #aaaaaa;
                    font-size: 12px;
                    margin-top: 5px;
                    margin-bottom: 0;
                  "
                >
                  Need assistance? Contact us at
                  <a
                    href="udoy.kumar2002@gmail.com"
                    style="color: #10b981; text-decoration: none"
                  >
                    <%= email %>
                  </a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
